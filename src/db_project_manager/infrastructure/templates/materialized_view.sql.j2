-- Создание материализованного представления {{ _qi(schema) }}.{{ _qi(name) }}
CREATE MATERIALIZED VIEW {{ _qi(schema) }}.{{ _qi(name) }}
TABLESPACE {{ tablespace }}
AS{{ definition }}
{{ data_status }};

{% if comment %}
-- Комментарий к материализованному представлению {{ _qi(schema) }}.{{ _qi(name) }}
COMMENT ON MATERIALIZED VIEW {{ _qi(schema) }}.{{ _qi(name) }} IS '{{ comment }}';
{% endif %}
{% for col in columns if col.comment %}
    {% if loop.first %}

-- Комментарии к колонкам
    {% endif %}
COMMENT ON COLUMN {{ _qi(schema) }}.{{ _qi(name) }}.{{ _qi(col.name) }} IS '{{ col.comment }}';
{% endfor %}
